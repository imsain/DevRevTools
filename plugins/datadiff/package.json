  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "datadiff": "bin/datadiff.mjs"
  },
  "engines": {
    "node": ">=21"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imsain/DevRevTools.git"
  },
  "keywords": [
    "sql",
    "data-diff",
    "visual-regression",
    "snowflake",
    "cli"
  ]
}
